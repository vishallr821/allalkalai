# Port configuration
PORT=4000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Providers
# NVIDIA NIM API (OpenAI-compatible)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Nebius Token Factory (Primary - OpenAI-compatible endpoints)
# Verified Nebius Base URLs:
#   - https://api.tokenfactory.nebius.ai/v1
#   - https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_API_KEY=your-nebius-token-factory-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1

# Verified Nebius Model Catalog:
# Tier 1 (Fast Triage & Translation):
#   - nvidia/nemotron-3-nano
#   - nvidia/nemotron-nano-9b-instruct
#   - nvidia/nemotron-3-nano-30b
MODEL_TIER1=nvidia/nemotron-3-nano

# Tier 2 (Deep Reasoning, Root Cause, Escalation):
#   - nvidia/nemotron-3-super-120b-a12b
#   - nvidia/nemotron-ultra-70b-instruct
#   - nvidia/nemotron-3-ultra-550b
MODEL_TIER2=nvidia/nemotron-3-super-120b-a12b

# Vision Model (Multimodal Resolution Verification):
#   - nvidia/nemotron-3.5-super-vl
#   - nvidia/nemotron-vision-preview
VISION_MODEL=nvidia/nemotron-3.5-super-vl

# Groq (Fallback Provider)
# Verified Groq Models:
#   - llama-3.3-70b-versatile
#   - openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# System / Feature Flags
DEMO_MODE=false
SLA_CHECK_INTERVAL_MS=60000
